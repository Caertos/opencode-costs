{
  "name": "opencode-costs-tui",
  "version": "2.1.0",
  "description": "Sidebar cost panel for OpenCode: per-agent cost and tokens for the current session and its subagents",
  "type": "module",
  "main": "./dist/tui.js",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "cost",
    "tokens",
    "subagent"
  ],
  "author": "Carlos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caertos/opencode-costs.git"
  },
  "homepage": "https://github.com/Caertos/opencode-costs#readme",
  "bugs": {
    "url": "https://github.com/Caertos/opencode-costs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx --yes esbuild@0.25.0 src/tui.tsx --bundle --format=esm --packages=external --jsx=automatic --jsx-import-source=@opentui/solid --outfile=dist/tui.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test test/report.test.ts"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.0 <0.6",
    "@opentui/solid": ">=0.4.0 <0.6",
    "solid-js": ">=1.9.12 <2"
  }
}
